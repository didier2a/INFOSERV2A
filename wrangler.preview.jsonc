{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "infoserv2a-mobile-chrome-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
  // Preview isolée uniquement : aucun Durable Object, aucune route et aucun
  // domaine personnalisé. Ne jamais utiliser cette config pour la production.
}
