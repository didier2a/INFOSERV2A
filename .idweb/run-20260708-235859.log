+:root {
+  color-scheme: dark;
+  --night: #020814;
+  --night-2: #06152a;
+  --panel: rgba(8, 24, 46, 0.78);
+  --panel-strong: rgba(7, 20, 39, 0.92);
+  --line: rgba(0, 220, 255, 0.22);
+  --line-strong: rgba(18, 247, 255, 0.48);
+  --cyan: #00d9f5;
+  --cyan-bright: #12f7ff;
+  --blue: #148cff;
+  --text: #f4f8ff;
+  --muted: #a8b7c9;
+  --quiet: #6f8195;
+  --shadow: 0 26px 90px rgba(0, 0, 0, 0.42);
+  --radius: 24px;
+  --container: 1220px;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html {
+  scroll-behavior: smooth;
+}
+
+body {
+  margin: 0;
+  min-width: 320px;
+  overflow-x: hidden;
+  background:
+    radial-gradient(circle at 78% 8%, rgba(20, 140, 255, 0.18), transparent 32rem),
+    radial-gradient(circle at 12% 42%, rgba(0, 217, 245, 0.1), transparent 28rem),
+    linear-gradient(180deg, #01050d 0%, var(--night) 34%, #031022 100%);
+  color: var(--text);
+}
+
+body.nav-open {
+  overflow: hidden;
+}
+
+a {
+  color: inherit;
+  text-decoration: none;
+}
+
+img {
+  display: block;
+  max-width: 100%;
+}
+
+h1,
+h2,
+h3,
+p {
+  margin-top: 0;
+}
+
+p {
+  color: var(--muted);
+  line-height: 1.7;
+}
+
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+.container,
+.header-inner,
+.footer-inner,
+.footer-bottom {
+  width: min(var(--container), calc(100% - 64px));
+  margin-inline: auto;
+}
+
+.site-header {
+  position: sticky;
+  top: 0;
+  z-index: 50;
+  min-height: 82px;
+  background: rgba(2, 8, 20, 0.86);
+  border-bottom: 1px solid rgba(0, 220, 255, 0.16);
+  backdrop-filter: blur(20px);
+  box-shadow: 0 14px 42px rgba(0, 0, 0, 0.22);
+}
+
+.header-inner {
+  min-height: 82px;
+  display: grid;
+  grid-template-columns: auto 1fr auto;
+  align-items: center;
+  gap: 28px;
+}
+
+.logo {
+  display: inline-flex;
+  align-items: center;
+  gap: 12px;
+  min-width: max-content;
+}
+
+.logo-mark {
+  width: 48px;
+  height: 48px;
+  position: relative;
+  border: 2px solid var(--cyan);
+  border-radius: 50%;
+  box-shadow: 0 0 34px rgba(0, 217, 245, 0.34);
+}
+
+.logo-mark::before,
+.logo-mark::after {
+  content: "";
+  position: absolute;
+  border-radius: 50%;
+}
+
+.logo-mark::before {
+  inset: 8px;
+  border: 1px solid rgba(18, 247, 255, 0.76);
+  border-left-color: transparent;
+}
+
+.logo-mark::after {
+  width: 9px;
+  height: 9px;
+  right: 9px;
+  bottom: 10px;
+  background: var(--cyan);
+  box-shadow: 0 0 18px var(--cyan);
+}
+
+.logo strong {
+  display: block;
+  color: var(--text);
+  font-size: 1.2rem;
+  line-height: 1;
+  letter-spacing: 0;
+}
+
+.logo small {
+  display: block;
+  margin-top: 5px;
+  color: var(--quiet);
+  font-size: 0.61rem;
+  font-weight: 700;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+}
+
+.main-nav {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: clamp(15px, 2.4vw, 31px);
+}
+
+.nav-link {
+  position: relative;
+  padding: 31px 0 29px;
+  color: var(--muted);
+  font-size: 0.78rem;
+  font-weight: 850;
+  text-transform: uppercase;
+}
+
+.nav-link::after {
+  content: "";
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: 21px;
+  height: 2px;
+  transform: scaleX(0);
+  transform-origin: center;
+  background: var(--cyan);
+  box-shadow: 0 0 14px rgba(18, 247, 255, 0.8);
+  transition: transform 160ms ease;
+}
+
+.nav-link:hover,
+.nav-link:focus-visible,
+.nav-link.active {
+  color: var(--cyan-bright);
+}
+
+.nav-link:hover::after,
+.nav-link.active::after {
+  transform: scaleX(1);
+}
+
+.header-cta,
+.button,
+.form-submit {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 12px;
+  min-height: 52px;
+  padding: 0 24px;
+  border: 1px solid transparent;
+  border-radius: 7px;
+  font: inherit;
+  font-size: 0.78rem;
+  font-weight: 900;
+  letter-spacing: 0;
+  text-transform: uppercase;
+  cursor: pointer;
+}
+
+.header-cta,
+.button-primary,
+.form-submit {
+  background: linear-gradient(135deg, var(--cyan-bright), var(--cyan) 52%, #08aeea);
+  color: #02101c;
+  box-shadow: 0 18px 48px rgba(0, 217, 245, 0.24);
+}
+
+.button-secondary {
+  background: rgba(3, 13, 29, 0.62);
+  border-color: var(--line);
+  color: var(--text);
+}
+
+.header-cta::after,
+.button::after,
+.form-submit::after {
+  content: "->";
+  font-size: 1rem;
+  line-height: 1;
+}
+
+.button:hover,
+.header-cta:hover,
+.form-submit:hover {
+  transform: translateY(-1px);
+  border-color: rgba(18, 247, 255, 0.56);
+}
+
+.mobile-toggle {
+  display: none;
+  width: 48px;
+  height: 48px;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 0.035);
+  color: var(--text);
+}
+
+.mobile-toggle span:not(.sr-only) {
+  display: block;
+  width: 22px;
+  height: 2px;
+  margin: 5px auto;
+  background: var(--text);
+}
+
+.hero {
+  position: relative;
+  min-height: var(--hero-height, 640px);
+  overflow: hidden;
+  border-bottom: 1px solid rgba(0, 220, 255, 0.12);
+}
+
+.hero.home {
+  --hero-height: 720px;
+}
+
+.hero-background,
+.hero::before,
+.hero::after {
+  position: absolute;
+  content: "";
+  inset: 0;
+  pointer-events: none;
+}
+
+.hero::before {
+  background-image: var(--hero-image);
+  background-size: cover;
+  background-position: center 6%;
+  opacity: 0.58;
+  filter: saturate(1.04);
+}
+
+.hero::after {
+  background:
+    linear-gradient(90deg, rgba(2, 8, 20, 0.96) 0%, rgba(2, 8, 20, 0.72) 43%, rgba(2, 8, 20, 0.24) 100%),
+    linear-gradient(180deg, rgba(2, 8, 20, 0.18) 0%, rgba(2, 8, 20, 0.9) 100%),
+    radial-gradient(circle at 72% 46%, rgba(18, 247, 255, 0.2), transparent 18rem);
+}
+
+.hero-inner {
+  position: relative;
+  z-index: 1;
+  width: min(var(--container), calc(100% - 64px));
+  min-height: var(--hero-height, 640px);
+  margin-inline: auto;
+  display: grid;
+  grid-template-columns: minmax(0, 650px) minmax(300px, 1fr);
+  gap: 48px;
+  align-items: center;
+  padding: 72px 0 50px;
+}
+
+.hero-content {
+  padding-top: 20px;
+}
+
+.hero-kicker,
+.section-kicker {
+  display: inline-flex;
+  align-items: center;
+  min-height: 29px;
+  margin: 0 0 18px;
+  padding: 0 14px;
+  border: 1px solid var(--line);
+  border-radius: 7px;
+  color: var(--cyan-bright);
+  background: rgba(5, 18, 36, 0.58);
+  font-size: 0.73rem;
+  font-weight: 900;
+  text-transform: uppercase;
+}
+
+.section-kicker {
+  min-height: auto;
+  padding: 0;
+  border: 0;
+  background: transparent;
+}
+
+.hero-title {
+  max-width: 760px;
+  margin-bottom: 22px;
+  font-size: clamp(3rem, 5.4vw, 5.15rem);
+  line-height: 1.03;
+  letter-spacing: 0;
+}
+
+.hero-title .accent,
+.section-title .accent {
+  color: var(--cyan);
+}
+
+.hero-text {
+  max-width: 670px;
+  margin-bottom: 0;
+  font-size: clamp(1.05rem, 1.45vw, 1.22rem);
+  line-height: 1.75;
+}
+
+.hero-actions,
+.cta-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 16px;
+  margin-top: 34px;
+}
+
+.hero-visual {
+  min-height: 360px;
+  display: grid;
+  place-items: center;
+}
+
+.hero-card {
+  position: relative;
+  width: min(100%, 430px);
+  min-height: 390px;
+  border: 1px solid rgba(18, 247, 255, 0.32);
+  border-radius: 50%;
+  background:
+    radial-gradient(circle, rgba(18, 247, 255, 0.25), transparent 20%),
+    repeating-radial-gradient(circle, rgba(18, 247, 255, 0.2) 0 1px, transparent 1px 48px);
+  box-shadow: inset 0 0 58px rgba(18, 247, 255, 0.12), 0 0 78px rgba(0, 217, 245, 0.18);
+  opacity: 0.92;
+}
+
+.hero-card::before {
+  content: "";
+  position: absolute;
+  inset: 25%;
+  border: 2px solid var(--cyan);
+  border-radius: 22px;
+  transform: rotate(45deg);
+  box-shadow: 0 0 34px rgba(18, 247, 255, 0.5);
+}
+
+.proof-bar {
+  position: relative;
+  z-index: 2;
+  width: min(var(--container), calc(100% - 64px));
+  margin: -74px auto 0;
+  display: grid;
+  grid-template-columns: repeat(var(--proof-cols, 4), minmax(0, 1fr));
+  gap: 0;
+  overflow: hidden;
+  border: 1px solid var(--line);
+  border-radius: 11px;
+  background: rgba(4, 13, 27, 0.82);
+  backdrop-filter: blur(18px);
+  box-shadow: var(--shadow);
+}
+
+.proof-item {
+  min-height: 94px;
+  display: grid;
+  grid-template-columns: 44px minmax(0, 1fr);
+  gap: 16px;
+  align-items: center;
+  padding: 22px 24px;
+  border-right: 1px solid rgba(0, 220, 255, 0.16);
+}
+
+.proof-item:last-child {
+  border-right: 0;
+}
+
+.icon {
+  width: 44px;
+  height: 44px;
+  display: grid;
+  place-items: center;
+  border: 1px solid rgba(18, 247, 255, 0.65);
+  border-radius: 50%;
+  color: var(--cyan-bright);
+  font-size: 0.78rem;
+  font-weight: 900;
+  box-shadow: inset 0 0 22px rgba(0, 217, 245, 0.12);
+}
+
+.proof-item strong,
+.mini-feature strong {
+  display: block;
+  margin-bottom: 4px;
+  color: var(--cyan-bright);
+  font-size: 0.82rem;
+  text-transform: uppercase;
+}
+
+.proof-item span,
+.mini-feature span {
+  color: var(--muted);
+  font-size: 0.9rem;
+  line-height: 1.45;
+}
+
+.section {
+  padding: clamp(74px, 8.5vw, 122px) 0;
+}
+
+.section.compact {
+  padding-top: clamp(44px, 6vw, 72px);
+}
+
+.section-dark {
+  background:
+    radial-gradient(circle at 12% 18%, rgba(20, 140, 255, 0.12), transparent 25rem),
+    rgba(2, 8, 20, 0.38);
+  border-block: 1px solid rgba(0, 220, 255, 0.12);
+}
+
+.section-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 0.82fr) minmax(320px, 1.18fr);
+  gap: clamp(40px, 7vw, 86px);
+  align-items: center;
+}
+
+.section-title {
+  max-width: 830px;
+  margin-bottom: 18px;
+  font-size: clamp(2.1rem, 3.7vw, 3.6rem);
+  line-height: 1.08;
+  letter-spacing: 0;
+}
+
+.section-lead {
+  max-width: 720px;
+  font-size: 1.08rem;
+}
+
+.section-heading {
+  display: flex;
+  justify-content: space-between;
+  align-items: end;
+  gap: 28px;
+  margin-bottom: 32px;
+}
+
+.section-heading > div {
+  max-width: 790px;
+}
+
+.section-link {
+  color: var(--cyan-bright);
+  font-size: 0.78rem;
+  font-weight: 900;
+  text-transform: uppercase;
+  white-space: nowrap;
+}
+
+.cards-grid {
+  display: grid;
+  grid-template-columns: repeat(var(--grid-cols, 4), minmax(0, 1fr));
+  gap: 22px;
+}
+
+.cards-grid.cols-3 {
+  --grid-cols: 3;
+}
+
+.cards-grid.cols-5 {
+  --grid-cols: 5;
+}
+
+.service-card,
+.sector-card,
+.method-card,
+.value-card,
+.contact-card,
+.step-card {
+  position: relative;
+  min-height: 230px;
+  padding: 28px;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  background:
+    linear-gradient(145deg, rgba(18, 247, 255, 0.06), rgba(20, 140, 255, 0.015) 42%, transparent),
+    var(--panel);
+  box-shadow: 0 18px 54px rgba(0, 0, 0, 0.21);
+}
+
+.service-card:hover,
+.sector-card:hover,
+.method-card:hover,
+.value-card:hover,
+.contact-card:hover,
+.step-card:hover {
+  border-color: var(--line-strong);
+  transform: translateY(-2px);
+}
+
+.card-icon {
+  width: 58px;
+  height: 58px;
+  display: grid;
+  place-items: center;
+  margin-bottom: 28px;
+  border: 1px solid rgba(18, 247, 255, 0.62);
+  border-radius: 18px;
+  color: var(--cyan-bright);
+  font-size: 1rem;
+  font-weight: 900;
+}
+
+.card-number {
+  position: absolute;
+  top: 30px;
+  right: 28px;
+  color: rgba(0, 217, 245, 0.52);
+  font-size: 0.92rem;
+  font-weight: 900;
+}
+
+.service-card h3,
+.sector-card h3,
+.method-card h3,
+.value-card h3,
+.contact-card h3,
+.step-card h3 {
+  margin-bottom: 12px;
+  font-size: 1.32rem;
+  line-height: 1.18;
+}
+
+.service-card p,
+.sector-card p,
+.method-card p,
+.value-card p,
+.contact-card p,
+.step-card p {
+  margin-bottom: 0;
+  font-size: 0.96rem;
+}
+
+.card-link {
+  display: inline-flex;
+  gap: 10px;
+  margin-top: 24px;
+  color: var(--cyan-bright);
+  font-size: 0.75rem;
+  font-weight: 900;
+  text-transform: uppercase;
+}
+
+.card-link::after {
+  content: "->";
+}
+
+.steps {
+  display: grid;
+  grid-template-columns: repeat(6, minmax(0, 1fr));
+  gap: 18px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.step-card {
+  min-height: 255px;
+  padding-top: 54px;
+  text-align: center;
+}
+
+.step-number {
+  position: absolute;
+  top: -15px;
+  left: 50%;
+  width: 34px;
+  height: 34px;
+  display: grid;
+  place-items: center;
+  transform: translateX(-50%);
+  border: 1px solid var(--cyan);
+  border-radius: 50%;
+  background: #041329;
+  color: var(--cyan-bright);
+  font-size: 0.9rem;
+  font-weight: 900;
+}
+
+.feature-row {
+  display: grid;
+  grid-template-columns: repeat(var(--feature-cols, 4), minmax(0, 1fr));
+  gap: 0;
+  border-block: 1px solid rgba(0, 220, 255, 0.14);
+}
+
+.mini-feature {
+  display: grid;
+  grid-template-columns: 48px minmax(0, 1fr);
+  gap: 16px;
+  padding: 26px 24px;
+  border-right: 1px solid rgba(0, 220, 255, 0.14);
+}
+
+.mini-feature:last-child {
+  border-right: 0;
+}
+
+.highlight-band,
+.cta-band {
+  position: relative;
+  overflow: hidden;
+  display: grid;
+  grid-template-columns: 120px minmax(0, 1fr) auto;
+  gap: 32px;
+  align-items: center;
+  padding: 30px 34px;
+  border: 1px solid rgba(18, 247, 255, 0.36);
+  border-radius: 14px;
+  background:
+    linear-gradient(90deg, rgba(0, 217, 245, 0.08), rgba(20, 140, 255, 0.04)),
+    rgba(5, 18, 36, 0.78);
+  box-shadow: var(--shadow);
+}
+
+.highlight-band::after,
+.cta-band::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background-image: var(--hero-image);
+  background-size: cover;
+  background-position: center 72%;
+  opacity: 0.13;
+}
+
+.highlight-band > *,
+.cta-band > * {
+  position: relative;
+  z-index: 1;
+}
+
+.band-mark {
+  width: 96px;
+  height: 96px;
+  border: 2px solid var(--cyan);
+  border-radius: 50%;
+  box-shadow: inset 0 0 28px rgba(18, 247, 255, 0.15), 0 0 28px rgba(0, 217, 245, 0.22);
+}
+
+.cta-title {
+  margin-bottom: 6px;
+  font-size: clamp(1.55rem, 2.4vw, 2.2rem);
+  line-height: 1.12;
+}
+
+.cta-text {
+  margin-bottom: 0;
+}
+
+.cta-actions {
+  margin-top: 0;
+}
+
+.two-column {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+  gap: 28px;
+}
+
+.local-map {
+  min-height: 360px;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  background:
+    radial-gradient(circle at 45% 52%, rgba(18, 247, 255, 0.35), transparent 5rem),
+    radial-gradient(circle at 58% 42%, rgba(20, 140, 255, 0.18), transparent 13rem),
+    linear-gradient(135deg, rgba(8, 24, 46, 0.7), rgba(2, 8, 20, 0.74));
+  position: relative;
+  overflow: hidden;
+}
+
+.local-map::before {
+  content: "";
+  position: absolute;
+  inset: 30px;
+  border: 1px solid rgba(18, 247, 255, 0.24);
+  border-radius: 42% 58% 44% 56%;
+  transform: rotate(10deg);
+}
+
+.local-map::after {
+  content: "Porto-Vecchio\A Sud Corse";
+  white-space: pre;
+  position: absolute;
+  right: 42px;
+  bottom: 38px;
+  color: var(--text);
+  font-size: 1.4rem;
+  font-weight: 900;
+}
+
+.bullets,
+.contact-list {
+  margin: 18px 0 0;
+  padding: 0;
+  list-style: none;
+}
+
+.bullets li,
+.contact-list li {
+  position: relative;
+  margin-bottom: 10px;
+  padding-left: 18px;
+  color: var(--muted);
+}
+
+.bullets li::before,
+.contact-list li::before {
+  content: "";
+  position: absolute;
+  left: 0;
+  top: 0.72em;
+  width: 5px;
+  height: 5px;
+  border-radius: 50%;
+  background: var(--cyan);
+}
+
+.contact-layout {
+  display: grid;
+  grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
+  gap: 48px;
+  padding: 36px;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  background: rgba(5, 18, 36, 0.6);
+}
+
+.contact-form {
+  display: grid;
+  gap: 18px;
+}
+
+.form-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 18px;
+}
+
+.form-field {
+  display: grid;
+  gap: 8px;
+}
+
+.form-field.full {
+  grid-column: 1 / -1;
+}
+
+.form-field label,
+.field-label {
+  color: var(--text);
+  font-size: 0.84rem;
+  font-weight: 800;
+}
+
+.form-input,
+.form-textarea,
+select.form-input {
+  width: 100%;
+  min-height: 52px;
+  padding: 13px 15px;
+  border: 1px solid rgba(0, 220, 255, 0.2);
+  border-radius: 7px;
+  background: rgba(2, 8, 20, 0.68);
+  color: var(--text);
+  font: inherit;
+}
+
+.form-textarea {
+  min-height: 132px;
+  resize: vertical;
+}
+
+.form-status {
+  min-height: 24px;
+  margin: 12px 0 0;
+  color: var(--cyan-bright);
+  font-weight: 800;
+}
+
+.request-types {
+  display: grid;
+  grid-template-columns: repeat(6, minmax(0, 1fr));
+  gap: 18px;
+}
+
+.request-card {
+  min-height: 150px;
+  display: grid;
+  place-items: center;
+  gap: 12px;
+  padding: 20px;
+  border: 1px solid var(--line);
+  border-radius: 16px;
+  background: var(--panel);
+  text-align: center;
+  color: var(--text);
+  font-weight: 800;
+}
+
+.request-card span:last-child {
+  width: 18px;
+  height: 18px;
+  border: 1px solid var(--quiet);
+  border-radius: 50%;
+}
