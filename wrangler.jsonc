{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "infoserv2a",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/claire-lab",
      "/claire-lab/"
    ]
  }
}
