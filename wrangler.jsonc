{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "infoserv2a",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CLAIRE_REQUEST_GUARD",
        "class_name": "ClaireRequestGuard"
      }
    ]
  }
  // ClaireRequestGuard existe déjà dans Cloudflare : ne pas ajouter de
  // migration new_*, renamed_* ou deleted_* sans connaître sa migration
  // d’origine. Cette config conserve le namespace et son état tels quels.
  // Domaines personnalisés : NE PAS activer ici tant que la zone infoserv2a.pro
  // n’est pas Active dans Cloudflare. Un custom_domain sur cette config serait
  // aussi déployé sur les previews de branche et volerait le domaine public.
  // Procédure : docs/activer-claire-sur-infoserv2a-pro.md étape B4.
  // "routes": [
  //   { "pattern": "infoserv2a.pro", "custom_domain": true },
  //   { "pattern": "www.infoserv2a.pro", "custom_domain": true }
  // ]
}
